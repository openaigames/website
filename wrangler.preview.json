{
  "name": "openaigames-preview",
  "account_id": "798cc288096e1beac5cb1611654fdf4a",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/internal/*",
      "/community/*",
      "/catalog.json"
    ]
  },
  "d1_databases": [
    {
      "binding": "CATALOG",
      "database_name": "openaigames-catalog",
      "database_id": "cb9dae75-dcd8-4a62-910b-fb299387a06a",
      "migrations_dir": "catalog-migrations"
    }
  ],
  "vars": {
    "CATALOG_MODE": "preview"
  }
}
