{
  "name": "openaigames-website",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scene/build.mjs && node scripts/build-site.mjs",
    "dev": "wrangler dev --config wrangler.json --local --port 8499 --ip 127.0.0.1 --inspector-port 0",
    "db:generate": "drizzle-kit generate",
    "db:local": "wrangler d1 migrations apply DB --local --config wrangler.json",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "three": "0.186.0"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "esbuild": "0.25.12",
    "wrangler": "4.92.0"
  }
}
